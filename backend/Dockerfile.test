ARG API_IMAGE=invoice-importer-api:ap01-cde
FROM ${API_IMAGE}
USER root
COPY backend/requirements-test.lock /tmp/requirements-test.lock
RUN pip install --no-cache-dir -r /tmp/requirements-test.lock
COPY backend/tests /app/tests
USER 10001:10001
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
