ARG API_IMAGE=invoice-importer-api:ap01-cde
FROM ${API_IMAGE}
USER root
COPY backend/requirements-test.lock /tmp/requirements-test.lock
RUN pip install --no-cache-dir -r /tmp/requirements-test.lock
COPY backend/tests /app/tests
COPY deploy/run-test-source.py /app/operator/run-test-source.py
COPY deploy/run-processing.py /app/operator/run-processing.py
COPY deploy/run-automation.py /app/operator/run-automation.py
COPY deploy/host-runtime.py /app/operator/host-runtime.py
COPY deploy/operations-host.py /app/operator/operations-host.py
COPY deploy/graph-access-host.py /app/operator/graph-access-host.py
COPY backend/app/operations_status.py /app/operator/operations-status.py
COPY deploy/compose.notification.yaml /app/operator/compose.notification.yaml
COPY deploy/compose.notification-init.yaml /app/operator/compose.notification-init.yaml
USER 10001:10001
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
