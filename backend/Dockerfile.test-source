FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY backend/requirements-test-source.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.lock
COPY backend/app/__init__.py backend/app/graph.py backend/app/graph_mail.py backend/app/graph_deadline.py backend/app/test_source.py backend/app/test_source_cli.py ./app/
USER 10001:10001
ENTRYPOINT ["python", "-m", "app.test_source_cli"]
