# Disabled AP12 example. Preserves original requests and operator pauses.
[Unit]
Description=Invoice Graph certificate operation reconciliation and status
Requires=invoice-importer.service
After=invoice-importer.service network-online.target time-sync.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /etc/invoice-importer/run-rotation.py opportunity --profile /etc/invoice-importer/rotation-host.json
TimeoutStartSec=900s
TimeoutStopSec=10s
KillMode=control-group
