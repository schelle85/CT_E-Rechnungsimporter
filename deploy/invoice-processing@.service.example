# Disabled AP08 example; fixed reviewed profiles and local image IDs required.
[Unit]
Description=Invoice importer bounded %i tick
Requires=invoice-importer.service
After=invoice-importer.service
PartOf=invoice-importer.service
RequiresMountsFor=/mnt/importer

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B /etc/invoice-importer/run-automation.py %i --profile /etc/invoice-importer/automation-host.json
TimeoutStartSec=780s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077
