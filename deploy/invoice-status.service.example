# Disabled AP08 example. Read-only collection stays independent of worker start/drain.
[Unit]
Description=Invoice operations status observation
After=docker.service time-sync.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /etc/invoice-importer/run-automation.py status --profile /etc/invoice-importer/status-host.json
TimeoutStartSec=15s
TimeoutStopSec=5s
KillMode=control-group
