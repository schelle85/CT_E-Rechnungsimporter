[Unit]
Description=Invoice host bounded admission and native APT maintenance
After=invoice-importer.service invoice-maintenance-recover.service network-online.target time-sync.target
Wants=invoice-importer.service invoice-maintenance-recover.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -I -B /etc/invoice-importer/run-maintenance.py scheduled
# Do not SIGKILL a native dpkg transaction; late finish never authorizes late reboot.
TimeoutStartSec=infinity
TimeoutStopSec=infinity
KillMode=process
SendSIGKILL=no
StandardOutput=journal
StandardError=journal
