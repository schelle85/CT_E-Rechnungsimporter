# Disabled example; install only after code and instance-specific review.
[Unit]
Description=Invoice host Sunday OS maintenance opportunity

[Timer]
OnCalendar=Sun *-*-* 03:00:00 Europe/Berlin
Persistent=false
AccuracySec=1s
RandomizedDelaySec=0
Unit=invoice-maintenance.service

[Install]
WantedBy=timers.target
